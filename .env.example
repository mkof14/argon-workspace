# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only: AI usage log, user invites

# Anthropic → console.anthropic.com → API Keys (one key for the whole company)
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL_QUICK=claude-haiku-5-5
AI_MODEL_DEEP=claude-sonnet-5-5

# Public URL of the workspace (for login links)
NEXT_PUBLIC_SITE_URL=https://workspace.agron1.com

# Leave Supabase variables empty to run in DEMO mode (sample data in the browser, no login).

# Direct email sending from Mail center (Google Workspace). Without these, "Open in Gmail" and "Copy formatted" still work.
# SMTP_PASS is a Google app password for info@agron1.com (myaccount.google.com → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@agron1.com
SMTP_PASS=
SMTP_FROM=info@agron1.com
